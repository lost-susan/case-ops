# Copy to .env (never commit .env). Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
CASEOPS_SECRET_KEY=
CASEOPS_WEBHOOK_SECRET=

# Frontend origin(s) allowed to call the API, as a JSON list. No wildcards.
CASEOPS_CORS_ORIGINS=["http://localhost:8080"]

# Same-site frontend + API (e.g. behind one domain): keep lax. Frontend on another site (e.g. *.vercel.app calling
# your API domain): set CASEOPS_COOKIE_SAMESITE=none (requires HTTPS).
CASEOPS_COOKIE_SECURE=true
CASEOPS_COOKIE_SAMESITE=lax

# Local development without HTTPS only:
# CASEOPS_ENV=development
# CASEOPS_COOKIE_SECURE=false
