# Copy to .env (never commit .env). Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
CASEOPS_SECRET_KEY=
CASEOPS_WEBHOOK_SECRET=

# How ambiguous numeric dates like 03/04/2026 are read in evidence: mdy (US) or dmy.
CASEOPS_INGEST_DATE_ORDER=mdy
# local = real extraction (PDF text, WhatsApp/text, OCR, optional speech-to-text); mock = metadata only.
CASEOPS_INGESTION_PROVIDER=local

# Contradiction proposals from a language model. OFF by default: turning it on SENDS EVIDENCE TEXT to the provider.
# Check client confidentiality / privilege obligations first. Needs a key and a model name you have access to.
CASEOPS_CONTRADICTION_PROVIDER=none
CASEOPS_ANTHROPIC_API_KEY=
CASEOPS_CONTRADICTION_MODEL=

# Development without Docker / HTTPS only (see README):
# CASEOPS_ENV=development
# CASEOPS_COOKIE_SECURE=false
# CASEOPS_CORS_ORIGINS=["http://localhost:8080"]
